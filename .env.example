# Copy to .env and fill in OPENROUTER_API_KEY. Every other value works as-is.

# --- LLM access -------------------------------------------------------------
# The only value you must supply. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any OpenAI-compatible model id. The constitution forbids hardcoding this at a
# call site, so swapping providers is a one-line change here.
LLM_MODEL=anthropic/claude-sonnet-5
LLM_TEMPERATURE=0.0

# --- MongoDB ----------------------------------------------------------------
# The application user holds the `read` role only. This is one of the two
# independent controls required by constitution Principle II; the other is the
# aggregation stage allow-list in app/agent/guards.py.
MONGO_URI=mongodb://procurement_app:procurement_app_pw@localhost:27017/procurement?authSource=procurement
MONGO_DB=procurement
MONGO_COLLECTION=purchase_orders

MONGO_APP_USER=procurement_app
MONGO_APP_PASSWORD=procurement_app_pw
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=root_pw

# Loader connects as root because it needs write access. Never used at runtime.
MONGO_ADMIN_URI=mongodb://root:root_pw@localhost:27017/?authSource=admin

# --- Answer bounds ----------------------------------------------------------
MAX_RESULT_ROWS=200          # FR-013
MAX_REPAIR_ATTEMPTS=3        # FR-008
QUESTION_DEADLINE_S=60       # SC-004 asks for 30; see README on provider variance
QUERY_TIMEOUT_MS=15000       # FR-026, passed to aggregate() as maxTimeMS

# --- Entity grounding -------------------------------------------------------
# rapidfuzz WRatio scores. >= THRESHOLD substitutes silently; the band between
# FLOOR and THRESHOLD goes to the clarification path (FR-014a).
FUZZY_MATCH_THRESHOLD=90
FUZZY_AMBIGUOUS_FLOOR=75

# --- Data coverage ----------------------------------------------------------
# Used to answer "that period isn't covered" rather than returning an empty
# result as though it were a finding (FR-015).
DATA_COVERAGE_START=2012-07-01
DATA_COVERAGE_END=2015-06-30

# --- Server -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:4200
LOG_LEVEL=INFO
